# Local secrets / environment for this project.
# Copy to .env and fill in the values:  cp .env_example .env
# .env is gitignored (never commit it); .env_example is the tracked template.
#
# The SLURM launchers under scripts/ source .env automatically.

# HuggingFace access token — https://huggingface.co/settings/tokens
# Avoids the "unauthenticated requests" warning + rate limits on model downloads,
# and is required for gated repos. Leave blank to download anonymously.
HF_TOKEN=

# Optional: override where HuggingFace caches downloaded models/weights.
# The sbatch scripts default to <repo>/hf-cache; point this at shared storage if
# your home quota is small.
# HF_HOME=/path/to/shared/hf-cache

# LLM speaker resolution — used by scripts/match_speakers.py --use-llm
# (model gpt-oss-120b). Without these the heuristic-only matching still runs.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.aisc.hpi.de/
